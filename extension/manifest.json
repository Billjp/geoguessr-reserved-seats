{
  "manifest_version": 3,
  "name": "GeoGuessr Reserved Seat Probe",
  "version": "0.3.2",
  "description": "予約席数を保存すると、主催者のPartyロビーでゲストの席を自動作成・接続する実験用ツールです。",
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.geoguessr.com/*"
  ],
  "incognito": "split",
  "minimum_chrome_version": "116",
  "content_scripts": [{
    "matches": ["https://www.geoguessr.com/*"],
    "js": ["reservation-page.js"],
    "run_at": "document_idle"
  }],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "GeoGuessr 予備ゲスト検証",
    "default_popup": "popup.html"
  },
  "key": ""
}
